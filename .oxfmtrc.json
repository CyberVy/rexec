{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 4,
  "useTabs": false,
  "semi": false,
  "singleQuote": false,
  "bracketSpacing": true,
  "trailingComma": "none",
  "printWidth": 120,
  "ignorePatterns": [
    "node_modules",
    ".wrangler",
    "dist",
    "bin"
  ]
}
