{
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "esnext", "webworker"],
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "paths": {
            "@/*": ["./core/*"],
            "@core/*": ["./core/*"]
        },
        "noEmit": true,
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noImplicitAny": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "incremental": true,
        "types": ["@types/node"]
    },
    "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
    "exclude": [
        "node_modules",
        ".wrangler",
        "dist",
        "frontend",
        "cli/debug/browser",
        "core/server",
        "src-tauri",
        "src-tauri/gen/apple/build",
        "draft",
        "extensions/vscode/dist"
    ]
}
