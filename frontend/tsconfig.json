{
    "compilerOptions": {
        "target": "esnext",
        "lib": ["dom", "dom.iterable", "esnext"],
        "types": ["react", "react-dom"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "jsx": "react-jsx",
        "incremental": true,
        "paths": {
            "@/*": ["./*", "../src/*"],
            "@rexec/*": ["../src/*"]
        }
    },
    "include": ["./**/*.ts", "./**/*.tsx", "../src-tauri/src/inject.ts"]
}
