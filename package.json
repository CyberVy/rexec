{
  "name": "rexec",
  "version": "0.1.0",
  "description": "Ultra-lightweight edge-routed remote execution engine",
  "type": "module",
  "private": true,
  "bin": {
    "rexec": "./dist/rexec.mjs",
    "rexec-agent": "./dist/rexec-agent.mjs"
  },
  "scripts": {
    "build:agent": "esbuild src/agent/index.ts --bundle --platform=node --format=esm --target=esnext --outfile=dist/rexec-agent.mjs --banner:js=\"#!/usr/bin/env -S node --experimental-websocket\"",
    "build:caller-terminal": "esbuild src/caller/terminal/index.ts --bundle --platform=node --format=esm --target=esnext --outfile=dist/rexec.mjs --banner:js=\"#!/usr/bin/env node\"",
    "build:vscode": "esbuild extensions/vscode/src/index.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --minify --outfile=extensions/vscode/dist/extension.js",
    "package:vscode": "npm run build:vscode && cd extensions/vscode && vsce package --no-dependencies",
    "install:vscode": "npm run build:vscode && mkdir -p ~/.vscode/extensions && ln -sfn \"$(pwd)/extensions/vscode\" ~/.vscode/extensions/rexec-vscode-0.1.0",
    "uninstall:vscode": "rm -rf ~/.vscode/extensions/rexec-vscode-0.1.0",
    "build:installers": "sh scripts/build_installers.sh",
    "build": "npm run build:agent && npm run build:caller-terminal && npm run build:vscode && npm run build:installers",
    "deploy": "npm run build && wrangler deploy",
    "debug:serve": "tsx cli/debug/serve.ts",
    "debug:test": "tsx cli/debug/tests/run_all.ts",
    "debug:test:basic": "tsx cli/debug/tests/basic.ts",
    "debug:test:env": "tsx cli/debug/tests/env_cwd.ts",
    "debug:test:abort": "tsx cli/debug/tests/abort.ts",
    "debug:test:large": "tsx cli/debug/tests/large_output.ts",
    "debug:test:transfer": "tsx cli/debug/tests/file_transfer.ts",
    "debug:test:forward": "tsx cli/debug/tests/forward.ts",
    "debug:test:tty": "tsx cli/debug/tests/tty.ts",
    "debug:test:heartbeat": "tsx cli/debug/tests/heartbeat.ts",
    "debug:test:vscode": "tsx cli/debug/tests/vscode_extension.ts",
    "test": "npm run debug:test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src cli extensions/vscode/src --deny-warnings",
    "format": "oxfmt src cli extensions/vscode/src",
    "format:check": "oxfmt --check src cli extensions/vscode/src",
    "check": "concurrently \"oxlint src cli extensions/vscode/src --deny-warnings\" \"tsc --noEmit\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260422.1",
    "@types/node": "^20",
    "@types/vscode": "^1.144.0",
    "@vscode/vsce": "^4.1.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.27.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "4.84.1"
  }
}
